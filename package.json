{
	"name": "n8n-nodes-payi",
	"version": "0.3.1",
	"description": "n8n community node for routing LLM requests through Pay-i proxy with cost tracking and budget enforcement",
	"keywords": [
		"n8n-community-node-package",
		"n8n",
		"pay-i",
		"llm",
		"ai",
		"cost-tracking",
		"proxy"
	],
	"license": "MIT",
	"homepage": "https://github.com/pay-i/n8n-nodes-payi",
	"author": {
		"name": "Pay-i",
		"email": "support@pay-i.com"
	},
	"repository": {
		"type": "git",
		"url": "https://github.com/Pay-i/n8n-nodes-payi"
	},
	"main": "index.js",
	"scripts": {
		"clean": "rm -rf dist",
		"build": "npm run clean && tsc && node scripts/copy-icons.js",
		"dev": "tsc --watch",
		"format": "prettier nodes credentials --write",
		"lint": "eslint nodes credentials",
		"lint:fix": "eslint nodes credentials --fix",
		"prepublishOnly": "npm run build"
	},
	"files": [
		"dist"
	],
	"n8n": {
		"n8nNodesApiVersion": 1,
		"credentials": [
			"dist/credentials/PayiApi.credentials.js",
			"dist/credentials/PayiDatabricksApi.credentials.js"
		],
		"nodes": [
			"dist/nodes/Payi/Payi.node.js",
			"dist/nodes/Payi/PayiChatModel.node.js",
			"dist/nodes/Payi/PayiChatModelAnthropic.node.js",
			"dist/nodes/Payi/PayiChatModelAzure.node.js",
			"dist/nodes/Payi/PayiChatModelBedrock.node.js",
			"dist/nodes/Payi/PayiChatModelDatabricks.node.js",
			"dist/nodes/Payi/PayiDatabricksModelServing.node.js"
		]
	},
	"devDependencies": {
		"eslint": "^10.1.0",
		"n8n-workflow": "*",
		"prettier": "~3.3.0",
		"typescript": "~5.5.0",
		"typescript-eslint": "^8.57.1"
	},
	"peerDependencies": {
		"n8n-workflow": "*"
	},
	"engines": {
		"node": ">=18"
	}
}
