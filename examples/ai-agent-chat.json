{
  "name": "Pay-i AI Agent Chat",
  "nodes": [
    {
      "parameters": {},
      "id": "trigger-1",
      "name": "Chat Trigger",
      "type": "@n8n/n8n-nodes-langchain.manualChatTrigger",
      "typeVersion": 1.1,
      "position": [0, 300]
    },
    {
      "parameters": {},
      "id": "agent-1",
      "name": "AI Agent",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [220, 300]
    },
    {
      "parameters": {
        "model": "gpt-4o",
        "providerApiKey": "",
        "userId": "demo-user",
        "useCaseName": "ai-agent-chat",
        "useCaseId": "={{ $execution.id }}",
        "useCaseVersion": "1",
        "useCaseStep": "",
        "useCaseProperties": "",
        "limitIds": "",
        "options": {
          "temperature": 0.7,
          "maxTokens": -1
        }
      },
      "id": "payi-chat-1",
      "name": "Pay-i Chat Model",
      "type": "n8n-nodes-payi.lmChatPayi",
      "typeVersion": 1,
      "position": [220, 520],
      "credentials": {
        "payiApi": {
          "id": "",
          "name": "Pay-i API"
        }
      }
    }
  ],
  "connections": {
    "Chat Trigger": {
      "main": [
        [
          {
            "node": "AI Agent",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "Pay-i Chat Model": {
      "ai_languageModel": [
        [
          {
            "node": "AI Agent",
            "type": "ai_languageModel",
            "index": 0
          }
        ]
      ]
    }
  },
  "settings": {
    "executionOrder": "v1"
  }
}
