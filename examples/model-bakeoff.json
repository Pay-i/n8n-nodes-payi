    {
      "parameters": {
        "mode": "combine",
        "combinationMode": "multiplex",
        "options": {}
      },
      "id": "merge-1",
      "name": "Combine Results",
      "type": "n8n-nodes-base.merge",
      "typeVersion": 3,
      "position": [740, 300]
    },
    {
      "parameters": {
        "jsCode": "const openai = $input.first().json;\nconst anthropic = $input.last().json;\n\n// Extract responses\nconst openaiResponse = openai.choices?.[0]?.message?.content || 'No response';\nconst anthropicResponse = anthropic.content?.[0]?.text || 'No response';\n\n// Extract costs\nconst openaiCost = openai.payiCost?.cost?.total?.base || 0;\nconst anthropicCost = anthropic.payiCost?.cost?.total?.base || 0;\n\nreturn [{\n  json: {\n    prompt: 'Explain what a reverse proxy is in exactly two sentences.',\n    results: {\n      openai: {\n        model: openai.model || 'gpt-4o-mini',\n        response: openaiResponse,\n        cost_usd: openaiCost,\n        request_id: openai.payiCost?.request_id || null\n      },\n      anthropic: {\n        model: anthropic.model || 'claude-3-5-haiku-20241022',\n        response: anthropicResponse,\n        cost_usd: anthropicCost,\n        request_id: anthropic.payiCost?.request_id || null\n      }\n    },\n    comparison: {\n      cheaper: openaiCost <= anthropicCost ? 'OpenAI' : 'Anthropic',\n      cost_difference_usd: Math.abs(openaiCost - anthropicCost),\n      total_cost_usd: openaiCost + anthropicCost\n    }\n  }\n}];"
      },
      "id": "code-1",
      "name": "Compare Results",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [960, 300]
    }
  ],
